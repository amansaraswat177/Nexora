# Copy to .env (docker compose reads it automatically)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Any OpenAI-compatible endpoint (OpenAI, Groq, Ollama, vLLM ...). Without a key the app still works:
# intent parsing falls back to rules and policy answers to extractive quotes.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
# Default is offline hash embeddings (no model download). For real semantic embeddings (Spring AI ONNX MiniLM, ~90 MB download on first start):
#   SHOPSMART_EMBEDDINGS=local  and  SPRING_AI_MODEL_EMBEDDING=transformers
SHOPSMART_EMBEDDINGS=hash
SPRING_AI_MODEL_EMBEDDING=none
